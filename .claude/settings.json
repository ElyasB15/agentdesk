{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Bash(docker compose config)",
      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-migrations.sh",
            "args": []
          }
        ]
      }
    ]
  }
}